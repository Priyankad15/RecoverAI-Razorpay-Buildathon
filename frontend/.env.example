# Copy to frontend/.env for local development.
# Vite only reads .env files from the frontend/ directory, so this is
# separate from the root .env.example used by the backend.

# Either name works (the client reads VITE_API_URL first, then falls
# back to VITE_API_BASE_URL) - set whichever your deployment platform's
# UI led you to configure. In Vercel, set this under Project Settings ->
# Environment Variables for the Production environment to your deployed
# Render backend URL, e.g. https://recoverai-api.onrender.com - never
# leave it pointing at localhost in a production deployment.
VITE_API_URL=http://localhost:8000
