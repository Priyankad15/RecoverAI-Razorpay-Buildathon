# NOTE: this is a copy of the root .env.example, placed here for
# discoverability when browsing backend/. The backend actually reads
# "../.env" relative to backend/ (see app/core/config.py), so your
# real .env file belongs at the REPOSITORY ROOT, not inside backend/.
# Copy this to the repo root as .env and fill in real values there:
#   cp backend/.env.example .env

# Copy this file to .env and fill in real values locally.
# Never commit the actual .env file.

# --- Backend / Database ---
# PostgreSQL connection string (Supabase or local Postgres).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recoverai

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- LLM provider (wired up in Phase 4) ---
# "mock" | "anthropic" | "openai" | "none". Defaults to "mock" so the
# agent works out of the box with no API key - the mock provider is a
# deterministic heuristic, clearly labeled, never presented as real AI.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_REQUEST_TIMEOUT_SECONDS=10

# --- Razorpay TEST MODE only - never production credentials ---
# This project uses Razorpay Test Mode. No real money is processed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_REQUEST_TIMEOUT_SECONDS=10
# MUST be "test" - startup fails if this is set to anything else.
RAZORPAY_MODE=test
# Verifies incoming webhook payloads (HMAC-SHA256) - see docs/razorpay-test-mode.md.
RAZORPAY_WEBHOOK_SECRET=

# --- Execution adapter selection (Phase 7) ---
# "simulation" (default, in-process, zero network calls) | "razorpay_test"
# (real calls to Razorpay's Test Mode API).
RECOVERY_EXECUTOR=simulation
# If RECOVERY_EXECUTOR=razorpay_test but credentials are missing, the
# executor factory fails with a clear error by default. Set this to true
# to fall back to the simulation executor instead (logged, never silent).
RAZORPAY_FALLBACK_TO_SIMULATION=false

# --- Rules engine (Phase 3) ---
# Max automated RETRY attempts before the engine blocks further retries.
MAX_AUTOMATED_RETRIES=2
# Minimum ML recovery_probability required to allow an automated RETRY.
MIN_RECOVERY_PROBABILITY=0.30
# Amount (INR) at/above which an active action requires human approval.
HIGH_VALUE_THRESHOLD_INR=50000
# Comma-separated failure_reason values that hard-block automated RETRY.
HARD_STOP_FAILURE_REASONS=risk_flagged

# --- Frontend ---
# Read by the frontend build (Vite) - base URL of the backend API.
VITE_API_BASE_URL=http://localhost:8000
